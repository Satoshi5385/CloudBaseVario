menu "CloudBaseVario application"

    choice CBV_BOARD_REVISION
        prompt "Board revision"
        default CBV_BOARD_AOHAZUKU_REV0

        config CBV_BOARD_AOHAZUKU_REV0
            bool "Aohazuku Rev.0"
    endchoice

    config CBV_SENSOR_RETRY_INTERVAL_MS
        int "Sensor re-detection interval (ms)"
        range 100 10000
        default 2000
        help
            Retry an unavailable BMP581 or HXY IMU without
            blocking the sensor task between attempts.

    config CBV_SENSOR_CONSECUTIVE_ERROR_LIMIT
        int "Consecutive sensor I2C error limit"
        range 1 100
        default 10
        help
            Reinitialize the affected BMP581 or HXY IMU after this many
            consecutive read failures. A timeout can also recreate the
            shared I2C bus.

endmenu
